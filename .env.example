# Local development: leave VITE_API_BASE empty to use the Vite /api proxy.
VITE_API_BASE=
# Backend origin (without /api). Match the URL printed when the backend starts.
API_PROXY_TARGET=https://localhost:7182
# For a deployed frontend, set VITE_API_BASE to the backend URL including /api:
# VITE_API_BASE=https://your-sport-center-be.onrender.com/api
# Restart Vite after changing these values.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
